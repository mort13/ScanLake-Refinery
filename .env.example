# Copy to .env for local development. .env is git-ignored.
GATEWAY_URL=https://gateway.scanlake.rocks
# sk_... key with scope "derived:write" (create it with ScanLake Gateway/scripts/create-api-key.mjs)
GATEWAY_API_KEY=
REFINERY_DATA_DIR=./data
# Keep local runs from uploading to the derived bucket.
REFINERY_PUBLISH=false
