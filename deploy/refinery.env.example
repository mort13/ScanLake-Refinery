# /etc/scanlake-refinery/refinery.env (root:scanlake, 0640), read by scanlake-refinery.service.
GATEWAY_URL=https://gateway.scanlake.rocks
# sk_... key with scope "derived:write", from ScanLake Gateway/scripts/create-api-key.mjs
GATEWAY_API_KEY=
REFINERY_PUBLISH=true
# Optional: report `refinery run` start, end and failure to ScanLake FrontDesk, e.g.
# https://scanlake.rocks and the bearer token of its /api/ingest/refinery route. Both or nothing.
#FRONTDESK_URL=
#FRONTDESK_TOKEN=
